{
  "name": "server",
  "version": "1.0.0",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "hash": "bun .scripts/hash-password.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate --config=src/configs/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/configs/drizzle.config.ts",
    "db:push": "bun --bun drizzle-kit push --config=src/configs/drizzle.config.ts",
    "db:studio": "bun --bun drizzle-kit studio --config=src/configs/drizzle.config.ts",
    "db:seed": "bun .scripts/seed.ts",
    "prices:sync": "bun .scripts/sync-prices.ts",
    "push:broadcast": "bun .scripts/push-broadcast.ts",
    "ai:probe":"bun .scripts/probe-models.ts",
    "check": "bun src/modules/hpp/hpp.engine.check.ts && bun src/modules/recipes/recipe.parser.check.ts && bun src/modules/commodities/pihps.parser.check.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "elysia": "latest",
    "envalid": "^8.2.0",
    "firebase-admin": "^14.5.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11"
  },
  "module": "src/index.ts"
}
